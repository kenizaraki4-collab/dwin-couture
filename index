<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dwin Couture</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ivory:#F2EBDD;
    --card:#FBF8F1;
    --charcoal:#221E1A;
    --charcoal-soft:#3A342C;
    --gold:#A9823D;
    --gold-soft:#D9C9A3;
    --burgundy:#6E2A38;
    --muted:#7A7166;
    --line:#DCD1BC;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--ivory);
    color:var(--charcoal);
    font-family:'Jost',sans-serif;
    font-weight:400;
    line-height:1.55;
    min-height:100vh;
  }
  h1,h2,h3,.serif{
    font-family:'Cormorant Garamond',serif;
    font-weight:600;
    letter-spacing:0.01em;
  }
  .wrap{max-width:1040px;margin:0 auto;padding:0 20px;}

  /* HEADER */
  header{
    padding:36px 20px 20px;
    text-align:center;
    border-bottom:1px solid var(--line);
  }
  header img{
    width:150px;
    height:150px;
    object-fit:contain;
    display:block;
    margin:0 auto 6px;
  }
  header p.tagline{
    margin:0;
    font-size:15px;
    font-style:italic;
    color:var(--muted);
    font-family:'Cormorant Garamond',serif;
  }

  /* TABS */
  .tabs{
    display:flex;
    justify-content:center;
    gap:0;
    margin:34px 0 28px;
    border-bottom:1px solid var(--line);
  }
  .tab-btn{
    background:none;
    border:none;
    font-family:'Cormorant Garamond',serif;
    font-size:22px;
    font-weight:600;
    color:var(--muted);
    padding:8px 26px 14px;
    cursor:pointer;
    position:relative;
    transition:color .25s ease;
  }
  .tab-btn.active{color:var(--charcoal);}
  .tab-btn.active::after{
    content:'';
    position:absolute;
    left:18%;right:18%;bottom:-1px;
    height:2px;
    background:var(--gold);
  }

  /* GRID */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:18px;
    padding:0 0 60px;
  }
  .card{
    background:var(--card);
    border:1px solid var(--line);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }
  .card .imgbox{
    aspect-ratio:3/4;
    background:#EFE7D6;
    overflow:hidden;
  }
  .card .imgbox img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .card .info{
    padding:12px 14px 16px;
    display:flex;
    flex-direction:column;
    gap:10px;
    flex:1;
  }
  .card .info h3{
    margin:0;
    font-size:19px;
    font-weight:600;
  }
  .card .order-btn{
    margin-top:auto;
    background:var(--charcoal);
    color:var(--ivory);
    border:none;
    padding:10px 12px;
    font-family:'Jost',sans-serif;
    font-size:13px;
    letter-spacing:0.03em;
    cursor:pointer;
    transition:background .2s ease;
  }
  .card .order-btn:hover{background:var(--burgundy);}

  .empty-state{
    text-align:center;
    padding:60px 20px;
    color:var(--muted);
    font-family:'Cormorant Garamond',serif;
    font-size:19px;
    font-style:italic;
  }

  /* FOOTER */
  footer{
    text-align:center;
    padding:22px 20px 34px;
    color:var(--muted);
    font-size:12px;
  }
  footer a{
    color:var(--muted);
    text-decoration:none;
    border-bottom:1px solid var(--line);
  }
  footer a:hover{color:var(--charcoal);}

  /* MODAL */
  .overlay{
    position:fixed;inset:0;
    background:rgba(34,30,26,0.55);
    display:none;
    align-items:flex-start;
    justify-content:center;
    padding:40px 16px;
    overflow-y:auto;
    z-index:50;
  }
  .overlay.show{display:flex;}
  .modal{
    background:var(--ivory);
    border:1px solid var(--line);
    max-width:440px;
    width:100%;
    padding:28px 24px 30px;
    position:relative;
  }
  .modal h2{margin:0 0 4px;font-size:24px;}
  .modal .sub{font-size:13px;color:var(--muted);margin:0 0 20px;}
  .modal label{
    display:block;
    font-size:12px;
    color:var(--muted);
    margin:14px 0 5px;
  }
  .modal input[type=text],
  .modal input[type=password],
  .modal select{
    width:100%;
    padding:9px 10px;
    border:1px solid var(--line);
    background:#fff;
    font-family:'Jost',sans-serif;
    font-size:14px;
  }
  .modal input[type=file]{
    width:100%;
    font-size:13px;
    margin-top:2px;
  }
  .modal .primary-btn{
    margin-top:20px;
    width:100%;
    background:var(--charcoal);
    color:var(--ivory);
    border:none;
    padding:11px;
    font-size:14px;
    letter-spacing:.02em;
    cursor:pointer;
  }
  .modal .primary-btn:hover{background:var(--burgundy);}
  .modal .close-x{
    position:absolute;top:14px;right:16px;
    background:none;border:none;font-size:20px;
    cursor:pointer;color:var(--muted);
    line-height:1;
  }
  .modal .error-msg{
    color:var(--burgundy);
    font-size:13px;
    margin-top:10px;
    display:none;
  }
  .radio-row{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
  .radio-row label{
    display:flex;align-items:center;gap:8px;
    font-size:14px;color:var(--charcoal);
    margin:0;
  }
  .divider{
    border:none;border-top:1px solid var(--line);
    margin:26px 0 18px;
  }
  .admin-list{
    display:flex;flex-direction:column;gap:8px;
    max-height:220px;overflow-y:auto;
    margin-top:10px;
  }
  .admin-list .row{
    display:flex;align-items:center;gap:10px;
    border:1px solid var(--line);
    padding:6px 8px;
    background:#fff;
    font-size:13px;
  }
  .admin-list .row img{
    width:36px;height:44px;object-fit:cover;
  }
  .admin-list .row .name{flex:1;}
  .admin-list .row .cat{color:var(--muted);font-size:11px;}
  .admin-list .row button{
    background:none;border:none;color:var(--burgundy);
    cursor:pointer;font-size:12px;
    text-decoration:underline;
  }
  .loading-note{
    text-align:center;color:var(--muted);
    font-size:13px;padding:30px;
  }
  .toast{
    position:fixed;bottom:20px;left:50%;
    transform:translateX(-50%);
    background:var(--charcoal);color:var(--ivory);
    padding:10px 18px;font-size:13px;
    opacity:0;pointer-events:none;
    transition:opacity .3s ease;
    z-index:80;
  }
  .toast.show{opacity:1;}
</style>
</head>
<body>

<header>
  <img src="data:image/jpeg;base64," alt="Dwin Couture">
  <p class="tagline">Sur-mesure &amp; prêt-à-porter</p>
</header>

<div class="wrap">
  <div class="tabs">
    <button class="tab-btn active" data-cat="hommes">Hommes</button>
    <button class="tab-btn" data-cat="enfants">Enfants</button>
  </div>

  <div id="grid" class="grid"></div>
  <div id="emptyState" class="empty-state" style="display:none;">Aucun modèle pour le moment dans cette catégorie.</div>
</div>

<footer>
  <a href="#" id="adminLink">Espace pro</a>
</footer>

<!-- ADMIN LOGIN MODAL -->
<div class="overlay" id="loginOverlay">
  <div class="modal">
    <button class="close-x" data-close="loginOverlay">&times;</button>
    <h2>Espace pro</h2>
    <p class="sub">Réservé à Dwin Couture</p>
    <label for="pwInput">Mot de passe</label>
    <input type="password" id="pwInput" placeholder="••••••••">
    <p class="error-msg" id="loginError">Mot de passe incorrect.</p>
    <button class="primary-btn" id="loginBtn">Entrer</button>
  </div>
</div>

<!-- ADMIN PANEL MODAL -->
<div class="overlay" id="adminOverlay">
  <div class="modal" style="max-width:480px;">
    <button class="close-x" data-close="adminOverlay">&times;</button>
    <h2>Gérer la boutique</h2>
    <p class="sub">Ajoute un modèle, choisis le numéro WhatsApp actif.</p>

    <label>Numéro WhatsApp pour les commandes</label>
    <div class="radio-row">
      <label><input type="radio" name="waNumber" value="22899601819"> +228 99-60-18-19</label>
      <label><input type="radio" name="waNumber" value="22891721745"> +228 91-72-17-45</label>
    </div>

    <hr class="divider">

    <h2 style="font-size:19px;">Ajouter un modèle</h2>
    <label for="prodName">Nom du modèle</label>
    <input type="text" id="prodName" placeholder="Ex : Costume trois pièces">
    <label for="prodCat">Catégorie</label>
    <select id="prodCat">
      <option value="hommes">Hommes</option>
      <option value="enfants">Enfants</option>
    </select>
    <label for="prodImg">Photo</label>
    <input type="file" id="prodImg" accept="image/*">
    <button class="primary-btn" id="addProdBtn">Ajouter à la boutique</button>

    <hr class="divider">

    <h2 style="font-size:19px;">Modèles en ligne</h2>
    <div class="admin-list" id="adminList"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const ADMIN_PASSWORD = "dwin2026";
let currentCat = "hommes";
let products = [];
let activeNumber = "22899601819";

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

function openOverlay(id){ document.getElementById(id).classList.add('show'); }
function closeOverlay(id){ document.getElementById(id).classList.remove('show'); }

document.querySelectorAll('[data-close]').forEach(btn=>{
  btn.addEventListener('click', ()=> closeOverlay(btn.getAttribute('data-close')));
});
document.querySelectorAll('.overlay').forEach(ov=>{
  ov.addEventListener('click', (e)=>{ if(e.target === ov) ov.classList.remove('show'); });
});

document.getElementById('adminLink').addEventListener('click', (e)=>{
  e.preventDefault();
  document.getElementById('pwInput').value = '';
  document.getElementById('loginError').style.display = 'none';
  openOverlay('loginOverlay');
});

document.getElementById('loginBtn').addEventListener('click', ()=>{
  const val = document.getElementById('pwInput').value;
  if(val === ADMIN_PASSWORD){
    closeOverlay('loginOverlay');
    renderAdminList();
    document.querySelectorAll('input[name=waNumber]').forEach(r=>{
      r.checked = (r.value === activeNumber);
    });
    openOverlay('adminOverlay');
  } else {
    document.getElementById('loginError').style.display = 'block';
  }
});
document.getElementById('pwInput').addEventListener('keydown', (e)=>{
  if(e.key === 'Enter') document.getElementById('loginBtn').click();
});

document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    currentCat = btn.getAttribute('data-cat');
    renderGrid();
  });
});

document.querySelectorAll('input[name=waNumber]').forEach(r=>{
  r.addEventListener('change', async ()=>{
    activeNumber = r.value;
    try{
      await window.storage.set('settings', JSON.stringify({activeNumber}), true);
      showToast('Numéro WhatsApp mis à jour.');
    }catch(err){ console.error(err); }
  });
});

document.getElementById('addProdBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('prodName').value.trim();
  const cat = document.getElementById('prodCat').value;
  const fileInput = document.getElementById('prodImg');
  const file = fileInput.files[0];

  if(!name || !file){
    showToast('Ajoute un nom et une photo.');
    return;
  }

  const reader = new FileReader();
  reader.onload = async () => {
    const newProduct = {
      id: 'p_' + Date.now(),
      name, category: cat,
      image: reader.result
    };
    products.push(newProduct);
    try{
      await window.storage.set('products', JSON.stringify(products), true);
      showToast('Modèle ajouté.');
      document.getElementById('prodName').value = '';
      fileInput.value = '';
      renderAdminList();
      renderGrid();
    }catch(err){
      console.error(err);
      showToast("Erreur lors de l'enregistrement.");
    }
  };
  reader.readAsDataURL(file);
});

async function deleteProduct(id){
  products = products.filter(p => p.id !== id);
  try{
    await window.storage.set('products', JSON.stringify(products), true);
    renderAdminList();
    renderGrid();
    showToast('Modèle supprimé.');
  }catch(err){ console.error(err); }
}

function renderAdminList(){
  const list = document.getElementById('adminList');
  list.innerHTML = '';
  if(products.length === 0){
    list.innerHTML = '<p style="color:var(--muted);font-size:13px;">Aucun modèle pour le moment.</p>';
    return;
  }
  products.forEach(p=>{
    const row = document.createElement('div');
    row.className = 'row';
    row.innerHTML = `<img src="${p.image}" alt=""><span class="name">${p.name}<br><span class="cat">${p.category}</span></span><button data-id="${p.id}">Supprimer</button>`;
    row.querySelector('button').addEventListener('click', ()=> deleteProduct(p.id));
    list.appendChild(row);
  });
}

function waLink(productName){
  const msg = "Bonjour, je suis intéressé(e) par le modèle : " + productName;
  return `https://wa.me/${activeNumber}?text=${encodeURIComponent(msg)}`;
}

function renderGrid(){
  const grid = document.getElementById('grid');
  const empty = document.getElementById('emptyState');
  const items = products.filter(p => p.category === currentCat);
  grid.innerHTML = '';
  if(items.length === 0){
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  items.forEach(p=>{
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `
      <div class="imgbox"><img src="${p.image}" alt="${p.name}"></div>
      <div class="info">
        <h3>${p.name}</h3>
        <button class="order-btn">Commander sur WhatsApp</button>
      </div>`;
    card.querySelector('.order-btn').addEventListener('click', ()=>{
      window.open(waLink(p.name), '_blank');
    });
    grid.appendChild(card);
  });
}

async function init(){
  try{
    const settingsRes = await window.storage.get('settings', true);
    if(settingsRes && settingsRes.value){
      const s = JSON.parse(settingsRes.value);
      if(s.activeNumber) activeNumber = s.activeNumber;
    }
  }catch(err){ /* no settings yet */ }

  try{
    const prodRes = await window.storage.get('products', true);
    if(prodRes && prodRes.value){
      products = JSON.parse(prodRes.value);
    }
  }catch(err){ /* no products yet */ }

  renderGrid();
}

init();
</script>
</body>
</html>
